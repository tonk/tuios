# PAM service file for the tuios-web PAM-trainee-auth prototype.
#
# Install as /etc/pam.d/tuios-web (root-owned, mode 0644):
#   sudo cp pam.d/tuios-web /etc/pam.d/tuios-web
#
# This mirrors a standard local-account login stack (see /etc/pam.d/login on
# a Debian/Ubuntu box) trimmed to what a headless, non-interactive-beyond-a-
# password login needs. pam_systemd registers a real logind session, which is
# what gives the trainee a proper XDG_RUNTIME_DIR and gets their processes
# cleaned up by the usual mechanisms when it closes.

auth     required   pam_unix.so
account  required   pam_unix.so
session  required   pam_unix.so
session  optional   pam_systemd.so
